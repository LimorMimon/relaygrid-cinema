# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the default Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Which agent backend app/api/agent/route.ts uses (see lib/agent-backends).
# "gemini-direct" (default) calls the public Gemini API directly with GEMINI_API_KEY.
# "agent-builder" calls the same function-calling loop through Vertex AI / Google Cloud
# Agent Builder instead (see the Google Cloud section below) — confirmed working end to
# end via Application Default Credentials, local-dev/demo use only for now; the deployed
# Vercel app stays on gemini-direct (see README.md's gap note on why: a real GCP
# service-account key is blocked by an org policy on this project, and Application
# Default Credentials only work from a machine that's run `gcloud auth
# application-default login`, which Vercel's serverless environment can't do).
AGENT_BACKEND=gemini-direct

# Which partner MCP server(s) to integrate (see lib/partner-mcp.ts). A
# single id, or a comma-separated list to run more than one at once —
# e.g. PARTNER_MCP=clickhouse,grafana ingests every sponsor event into both
# and exposes both partners' tools to Gemini. One partner having a problem
# (bad credentials, its subprocess won't start) never affects the other or
# crashes anything — it's just silently dropped from that call, logged
# server-side only. Unset/blank/"none" = no partner integration. (Replit
# support is not implemented.)
PARTNER_MCP=clickhouse,grafana

# ClickHouse Cloud connection (ClickHouse Partner Track — see lib/partner-mcp.ts).
# Fill these in from the "Connect" / connection-details screen ClickHouse Cloud
# shows right after you create the service (the password is shown once only).
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
# mcp-clickhouse defaults to read-only (rejects INSERT/CREATE TABLE) unless this is set —
# required for the real event-ingestion pipeline (app/api/sponsor-ingest/route.ts).
CLICKHOUSE_ALLOW_WRITE_ACCESS=true

# Grafana Cloud connection (Grafana Partner Track — see lib/partner-mcp.ts).
# Download the mcp-grafana binary for your platform from
# https://github.com/grafana/mcp-grafana/releases into .mcp-grafana/ first
# (Windows: .mcp-grafana/mcp-grafana.exe).
#
# GRAFANA_URL / GRAFANA_SERVICE_ACCOUNT_TOKEN power the MCP tool-calling
# side (dashboard search, Loki/Prometheus queries, alert rules, ...) — from
# your stack's URL and Administration -> Service accounts -> Add service
# account token (grant it at least Viewer; Editor if you want write tools).
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
#
# GRAFANA_LOKI_* power the separate real-time event write path
# (app/api/sponsor-ingest/route.ts) — Loki's push API is a distinct service
# from the Grafana HTTP API above, with its own credentials. From your
# stack's "Loki" details page: GRAFANA_LOKI_PUSH_URL is the "URL" field
# with /loki/api/v1/push appended, GRAFANA_LOKI_USER is the numeric
# "User" / instance ID shown there, and GRAFANA_LOKI_API_KEY is an access
# policy token scoped to logs:write (Administration -> Access Policies).
GRAFANA_LOKI_PUSH_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_API_KEY=

# Google Cloud / Vertex AI (Agent Builder backend — see lib/agent-backends/agent-builder.ts).
# Set AGENT_BACKEND=agent-builder above to use these. gemini-direct keeps working
# regardless of whether these are filled in.
# GOOGLE_CLOUD_PROJECT: the Project ID (not the display name) from the top of
#   https://console.cloud.google.com after creating the project.
# GOOGLE_CLOUD_LOCATION: use "global", not a regional value like "us-central1" — newer
#   Gemini models (e.g. the 3.x family) 404 ("Publisher Model ... was not found") on
#   regional Vertex AI endpoints and are only reachable through "global" — confirmed live.
# Auth — pick ONE:
#   (a) Recommended for local dev: leave GOOGLE_APPLICATION_CREDENTIALS_JSON and the GCP_*
#       Workload Identity Federation vars below empty, and run `gcloud auth
#       application-default login` once on this machine. The "Vertex AI Agent Platform API"
#       must be enabled on the project, and the Google account you log in with there needs
#       the "Agent Platform User" IAM role on the project — note this is the ACCOUNT YOU
#       AUTHENTICATE AS in that browser flow, which may not be the same Google account that
#       owns/created the project if you have more than one signed in (confirmed live:
#       authenticating as the wrong account produces a 403 PERMISSION_DENIED on
#       aiplatform.endpoints.predict, not an auth error).
#   (b) For a real deployment on Vercel: fill in the GCP_* vars below (Workload Identity
#       Federation) — no service-account key involved at all, so it isn't blocked by a
#       project's iam.disableServiceAccountKeyCreation org policy the way (c) below is.
#       Confirmed live end to end on the public relaygrid-cinema.vercel.app URL, not just
#       locally. One-time GCP Console setup (IAM & Admin -> Workload Identity Federation):
#         1. Create a pool (any ID, e.g. "vercel-<project>") and add an OIDC provider to it
#            named e.g. "vercel", issuer https://oidc.vercel.com/<your-vercel-team-slug>
#            (find your team slug in any VERCEL_OIDC_TOKEN's "iss" claim, or Vercel's own
#            org settings), attribute mapping google.subject = assertion.sub. Leave the
#            JWK file empty — Vercel's issuer is publicly reachable.
#         2. Grant access -> service account impersonation -> pick (or create) a service
#            account with the "Agent Platform User" role -> principal attribute "subject",
#            value owner:<team-slug>:project:<vercel-project-name>:environment:production
#            (scope it to whichever Vercel environment(s) should actually get this access).
#         3. Fill in GCP_PROJECT_NUMBER (shown on the pool's IAM principal string in the
#            Console), GCP_SERVICE_ACCOUNT_EMAIL, GCP_WORKLOAD_IDENTITY_POOL_ID, and
#            GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID below, then set these as real Vercel
#            project env vars (not just here) via `vercel env add <NAME> production`.
#       None of these 4 values are secret — they're resource identifiers, not credentials;
#       the actual short-lived token exchange happens at request time via `@vercel/oidc`.
#   (c) GOOGLE_APPLICATION_CREDENTIALS_JSON — the *entire contents* of a service account
#       JSON key (IAM & Admin -> Service Accounts -> your account -> Keys -> Add key ->
#       JSON), pasted as one line, from an account granted "Agent Platform User". A JSON
#       blob in an env var, not a file path, because Vercel's filesystem isn't a place to
#       keep a secret file. Kept as a fallback for GCP projects without the org policy
#       that blocks this — try (b) first for a real deployment.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

