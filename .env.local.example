# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the default Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Which agent backend app/api/agent/route.ts uses (see lib/agent-backends).
# "gemini-direct" (default, implemented) calls the Gemini API directly.
# "agent-builder" (not implemented yet) will run through Google Cloud
# Agent Builder / the Gemini Enterprise Agent Platform.
AGENT_BACKEND=gemini-direct

# Which partner MCP server to integrate (see lib/partner-mcp.ts).
# Unset / "none" = no partner integration (current state). Grafana/Replit
# support is not implemented yet.
# PARTNER_MCP=grafana

# ClickHouse Cloud connection (ClickHouse Partner Track — see lib/partner-mcp.ts).
# Fill these in from the "Connect" / connection-details screen ClickHouse Cloud
# shows right after you create the service (the password is shown once only).
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
# mcp-clickhouse defaults to read-only (rejects INSERT/CREATE TABLE) unless this is set —
# required for the real event-ingestion pipeline (app/api/sponsor-ingest/route.ts).
CLICKHOUSE_ALLOW_WRITE_ACCESS=true

PARTNER_MCP=clickhouse

# Google Cloud / Vertex AI (Agent Builder backend — see lib/agent-backends/agent-builder.ts).
# Set AGENT_BACKEND=agent-builder above once these are filled in and the backend is
# implemented; until then gemini-direct keeps working regardless of these being empty.
# GOOGLE_CLOUD_PROJECT: the Project ID (not the display name) from the top of
#   https://console.cloud.google.com after creating the project.
# GOOGLE_CLOUD_LOCATION: a Vertex AI region, e.g. us-central1.
# GOOGLE_APPLICATION_CREDENTIALS_JSON: the *entire contents* of the service account JSON
#   key file (IAM & Admin -> Service Accounts -> your account -> Keys -> Add key -> JSON),
#   pasted as one line. That account needs the "Vertex AI User" role. A JSON blob in an env
#   var (not a file path) because Vercel's filesystem isn't a place to keep a secret file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_JSON=
