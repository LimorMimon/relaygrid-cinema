# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the default Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Which agent backend app/api/agent/route.ts uses (see lib/agent-backends).
# "gemini-direct" (default, implemented) calls the Gemini API directly.
# "agent-builder" (not implemented yet) will run through Google Cloud
# Agent Builder / the Gemini Enterprise Agent Platform.
AGENT_BACKEND=gemini-direct

# Which partner MCP server to integrate (see lib/partner-mcp.ts).
# Unset / "none" = no partner integration (current state). Grafana/Replit
# support is not implemented yet.
# PARTNER_MCP=grafana
